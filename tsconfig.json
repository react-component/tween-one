{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "importHelpers": true,
    "jsx": "react",
    "typeRoots": ["./typings"],
    "declaration": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "strict": true,
    "paths": {
      "@/*": ["src/*"],
      "@@/*": ["src/.umi/*"],
      "@rc-component/tween-one": ["src/index.tsx"],
      "@rc-component/tween-one/es/*": ["src/*"],
      "@rc-component/tween-one/lib/*": ["src/*"],
      "rc-tween-one": ["src/index.tsx"],
      "rc-tween-one/es/*": ["src/*"],
      "rc-tween-one/lib/*": ["src/*"]
    },
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["node_modules", "lib", "es", "dist", "docs-dist", "typings", "**/__test__", "test"]
}
